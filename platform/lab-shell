#!/usr/bin/env bash
# Buka shell pemain di sebuah node lab, dengan perekaman.
# Usage: lab-shell <problem_dir> <node>
#
# - Command terstruktur dicatat oleh hook di dalam node (lab-rc.sh).
# - Transcript mentah (input + output + timing) dicatat oleh `script` di host,
#   untuk dibaca evaluator di Fase 2.
# Dipakai langsung dari terminal, atau oleh ttyd (platform/serve, server.py).
# Instance dipilih env LAB_INSTANCE (default local), lihat platform/instance.py.
set -euo pipefail

if (( $# != 2 )); then
  echo "Usage: lab-shell <problem_dir> <node>   (contoh: platform/lab-shell labs/net-001 sw2)" >&2
  exit 1
fi
HERE=$(cd "$(dirname "$0")" && pwd)
PROBLEM_DIR=$(cd "$1" && pwd)
NODE=$2

[[ $NODE =~ ^[a-z0-9-]+$ ]] || { echo "Nama node tidak valid: $NODE" >&2; exit 1; }

PY="$(dirname "$HERE")/.venv/bin/python"
[[ -x $PY ]] || PY=python3
# LAB_CTR, LAB_NODE_KIND, LAB_STATE_DIR, ... untuk instance ini.
INSTANCE_ENV=$("$PY" "$HERE/instance.py" env "$PROBLEM_DIR" --node "$NODE") || exit 1
eval "$INSTANCE_ENV"
export LAB_INSTANCE
CTR=$LAB_CTR
STATE=$LAB_STATE_DIR

if [[ "$(docker inspect -f '{{.State.Running}}' "$CTR" 2>/dev/null)" != "true" ]]; then
  echo "Node '$NODE' tidak berjalan (container $CTR). Sudah ./reset.sh?" >&2
  exit 1
fi

SESSION=$(cat "$STATE/session_id" 2>/dev/null || echo unknown)
mkdir -p "$STATE/tty"
stamp=$(date +%Y%m%d-%H%M%S)

host_event() {
  printf '{"ts":%s,"session":"%s","node":"%s","type":"%s"}\n' \
    "${EPOCHREALTIME/,/.}" "$SESSION" "$NODE" "$1" >> "$STATE/events/host.jsonl"
}

host_event shell_open
trap 'host_event shell_close' EXIT

# Node RouterOS (kind mikrotik_ros) tidak punya bash: shell-nya proxy di host
# (ros.py shell) yang mencatat event sendiri. Node lain: bash + hook lab-rc.sh.
if [[ $LAB_NODE_KIND == mikrotik_ros ]]; then
  INNER="$PY $HERE/ros.py shell $PROBLEM_DIR $NODE"
else
  INNER="docker exec -it -e LAB_NODE=$NODE -e LAB_SESSION=$SESSION $CTR bash --rcfile /etc/lab/rc -i"
fi

script -q -f \
  -B "$STATE/tty/${NODE}-${stamp}.log" \
  -T "$STATE/tty/${NODE}-${stamp}.timing" \
  -m advanced \
  -c "$INNER"
