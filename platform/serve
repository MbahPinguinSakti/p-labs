#!/usr/bin/env bash
# Jalankan terminal web (ttyd) + checkpoint watcher untuk satu soal.
# Usage: serve [problem_dir] [port]
#   problem_dir default: direktori saat ini (harus berisi problem.yaml)
# Buka http://localhost:<port>/?arg=<node>
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
PY="$(dirname "$HERE")/.venv/bin/python"
[[ -x $PY ]] || PY=python3
PROBLEM_DIR=$(cd "${1:-.}" && pwd)
PORT=${2:-7681}

if [[ ! -f "$PROBLEM_DIR/problem.yaml" ]]; then
  echo "Tidak ada problem.yaml di $PROBLEM_DIR" >&2
  echo "Usage: serve [problem_dir] [port]   (contoh: platform/serve labs/net-001)" >&2
  exit 1
fi

command -v ttyd >/dev/null || { echo "ttyd belum terinstall (lihat docs/instalasi.md)" >&2; exit 1; }
[[ -f "$PROBLEM_DIR/.state/session_id" ]] || { echo "Belum ada sesi. Jalankan ./reset.sh dulu." >&2; exit 1; }
if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
  echo "Port $PORT sudah dipakai (di Ubuntu/Debian biasanya service 'ttyd' bawaan: sudo systemctl disable --now ttyd)." >&2
  echo "Atau pakai port lain: serve $PROBLEM_DIR 7690" >&2
  exit 1
fi

"$PY" "$HERE/checkpoints.py" watch "$PROBLEM_DIR" > "$PROBLEM_DIR/.state/watch.log" 2>&1 &
WATCH_PID=$!
trap 'kill $WATCH_PID 2>/dev/null' EXIT

TOPO=$(ls "$PROBLEM_DIR"/*.clab.yaml | head -1)
NODES=$("$PY" -c 'import sys,yaml; print(" ".join(yaml.safe_load(open(sys.argv[1]))["topology"]["nodes"]))' "$TOPO")

echo "Watcher berjalan (log: $PROBLEM_DIR/.state/watch.log)"
echo "Terminal:"
for n in $NODES; do echo "  $n  http://localhost:${PORT}/?arg=${n}"; done

# -a: argumen dari URL (?arg=) diteruskan ke lab-shell sebagai nama node.
# -i lo: hanya bisa diakses dari mesin ini.
ttyd -W -a -i lo -p "$PORT" -t titleFixed="lab" "$HERE/lab-shell" "$PROBLEM_DIR"
